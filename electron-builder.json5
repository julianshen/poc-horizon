{
  appId: "com.horizon.browser",
  productName: "Horizon",
  directories: {
    output: "release",
  },
  files: [
    "dist",
    "dist-electron",
    "resources",
    "!resources/bin/**/*",
    "!resources/pi-extension/**/*",
  ],
  // The Pi binary + its extension must be real on-disk paths so the
  // external Pi subprocess can read them (asar is opaque to non-Electron
  // processes). They ship only as extraResources — excluded from the asar
  // above to avoid duplication; resolvePiResource() resolves both the
  // Electron-side (skills) and subprocess-side reads to these copies.
  extraResources: [
    { from: "resources/bin", to: "bin" },
    { from: "resources/pi-extension", to: "pi-extension" },
  ],
  mac: {
    target: [
      { target: "dmg", arch: ["x64", "arm64"] },
      { target: "zip", arch: ["x64", "arm64"] },
    ],
    category: "public.app-category.productivity",
    hardenedRuntime: true,
    gatekeeperAssess: false,
  },
  win: {
    target: [
      { target: "nsis", arch: ["x64"] },
      { target: "portable", arch: ["x64"] },
    ],
  },
  linux: {
    target: [
      { target: "AppImage", arch: ["x64"] },
      { target: "deb", arch: ["x64"] },
      { target: "rpm", arch: ["x64"] },
    ],
    category: "Network",
  },
  publish: {
    provider: "github",
    owner: "horizon-browser",
    repo: "horizon",
  },
}
