{
  "name": "horizon-browser",
  "version": "1.0.0",
  "description": "Horizon — A cross-platform desktop browser",
  "main": "./dist-electron/main.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "build:pi": "node scripts/build-pi.mjs",
    "dist": "npm run build:pi && electron-builder",
    "dist:mac": "npm run build:pi && electron-builder --mac",
    "dist:win": "npm run build:pi && electron-builder --win",
    "dist:linux": "npm run build:pi && electron-builder --linux",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "@types/uuid": "^10.0.0",
    "better-sqlite3": "^12.10.0",
    "electron-updater": "^6.3.0",
    "streamdown": "^2.5.0",
    "uuid": "^14.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.78.0",
    "@playwright/test": "^1.49.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/coverage-v8": "^2.1.9",
    "autoprefixer": "^10.4.0",
    "electron": "^34.5.8",
    "electron-builder": "^25.0.0",
    "electron-vite": "^2.0.0",
    "eslint": "^9.0.0",
    "globals": "^17.6.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.0",
    "prettier": "^3.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.59.4",
    "vite": "^6.0.0",
    "vitest": "^2.0.0"
  }
}
